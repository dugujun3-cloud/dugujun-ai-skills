{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dugujun-solo-business-workflow-status.schema.json",
  "title": "独孤菌一人公司端到端工作流状态",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_namespace",
    "workflow_id",
    "workflow_type",
    "revision",
    "cycle",
    "project",
    "guardrails",
    "overall_status",
    "current_stage",
    "stages",
    "event_log",
    "handoff",
    "external_actions",
    "next_actions",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "workflow_namespace": {"const": "dugujun.solo_business.v1"},
    "workflow_id": {"type": "string", "pattern": "^sbw_[a-f0-9]{12}$"},
    "workflow_type": {"const": "solo_business_end_to_end"},
    "revision": {"type": "integer", "minimum": 0},
    "cycle": {"type": "integer", "minimum": 1},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "root", "brief_path", "goal"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "root": {"type": "string", "minLength": 1},
        "brief_path": {"type": ["string", "null"]},
        "goal": {"type": ["string", "null"]}
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_only_writes", "knowledge_base_read_only", "no_auto_publish", "no_auto_payment", "no_auto_contract", "no_external_writes", "read_only_roots"],
      "properties": {
        "workspace_only_writes": {"const": true},
        "knowledge_base_read_only": {"const": true},
        "no_auto_publish": {"const": true},
        "no_auto_payment": {"const": true},
        "no_auto_contract": {"const": true},
        "no_external_writes": {"const": true},
        "read_only_roots": {"type": "array", "items": {"type": "string"}}
      }
    },
    "overall_status": {"enum": ["active", "awaiting_acceptance", "blocked", "paused", "completed", "stopped", "recovery_needed"]},
    "current_stage": {"type": ["string", "null"]},
    "stages": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/stage"}},
    "event_log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "last_seq", "last_event_id"],
      "properties": {
        "path": {"const": "events.jsonl"},
        "last_seq": {"type": "integer", "minimum": 0},
        "last_event_id": {"type": ["string", "null"]}
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "generated_from_revision", "sha256"],
      "properties": {
        "path": {"const": "handoff.md"},
        "generated_from_revision": {"type": "integer", "minimum": 0},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "external_actions": {"type": "array", "items": {"$ref": "#/$defs/external_action"}},
    "blocked_stage": {"type": ["string", "null"]},
    "next_actions": {"type": "array", "items": {"type": "string"}},
    "self_check": {"type": "object"},
    "last_request_ids": {"type": "array", "maxItems": 100, "items": {"type": "string"}},
    "product_branch": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["primary", "deferred", "rationale", "set_at"],
      "properties": {
        "primary": {"enum": ["consulting", "course", "product_knowledge_base", "web_app"]},
        "deferred": {"type": "array", "uniqueItems": true, "items": {"enum": ["consulting", "course", "product_knowledge_base", "web_app"]}},
        "rationale": {"type": "string", "minLength": 1},
        "set_at": {"type": "string", "format": "date-time"}
      }
    },
    "stop_reason": {"type": ["string", "null"]},
    "stopped_at": {"type": ["string", "null"], "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "kind", "required", "status", "sha256", "accepted_sha256", "updated_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"},
        "kind": {"enum": ["file", "directory"]},
        "required": {"type": "boolean"},
        "status": {"enum": ["missing", "draft", "ready", "accepted"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "accepted_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "updated_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "accepted_by", "accepted_at", "note", "scope"],
      "properties": {
        "required": {"type": "boolean"},
        "accepted_by": {"type": ["string", "null"]},
        "accepted_at": {"type": ["string", "null"], "format": "date-time"},
        "note": {"type": ["string", "null"]},
        "scope": {"const": "stage_artifacts_only"}
      }
    },
    "blocker": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["reason", "owner", "unblock_condition", "fallback", "blocked_at", "evidence_ref"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "owner": {"enum": ["user", "codex", "external_professional", "external_state"]},
        "unblock_condition": {"type": "string", "minLength": 1},
        "fallback": {"type": ["string", "null"]},
        "blocked_at": {"type": "string", "format": "date-time"},
        "evidence_ref": {"type": ["string", "null"]}
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "title", "status", "depends_on", "entry_criteria", "exit_criteria", "artifacts", "acceptance", "blocker", "attempts", "started_at", "completed_at"],
      "properties": {
        "order": {"type": "integer", "minimum": 0},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["pending", "in_progress", "awaiting_acceptance", "accepted", "blocked", "paused", "stopped"]},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "entry_criteria": {"type": "array", "items": {"type": "string"}},
        "exit_criteria": {"type": "array", "items": {"type": "string"}},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "acceptance": {"$ref": "#/$defs/acceptance"},
        "blocker": {"$ref": "#/$defs/blocker"},
        "attempts": {"type": "integer", "minimum": 0},
        "started_at": {"type": ["string", "null"], "format": "date-time"},
        "completed_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "external_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "performer", "state", "evidence_ref", "note", "recorded_at", "updated_at", "history"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"enum": ["publish", "payment", "contract", "registration", "outbound_message", "external_write"]},
        "performer": {"const": "user_or_authorized_human"},
        "state": {"enum": ["prepared", "awaiting_approval", "approved", "user_reported_performed", "verified", "rejected", "expired", "not_applicable"]},
        "evidence_ref": {"type": ["string", "null"]},
        "note": {"type": ["string", "null"]},
        "recorded_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "history": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "recorded_at", "evidence_ref", "note"],
            "properties": {
              "state": {"enum": ["prepared", "awaiting_approval", "approved", "user_reported_performed", "verified", "rejected", "expired", "not_applicable"]},
              "recorded_at": {"type": "string", "format": "date-time"},
              "evidence_ref": {"type": ["string", "null"]},
              "note": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}
